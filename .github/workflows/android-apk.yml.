name: Build Android APK

on:
  push:
    branches: [ main, master ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
    - name: Checkout Repository
      uses: actions/checkout@v4

    - name: Setup Node.js
      uses: actions/setup-node@v4
      with:
        node-version: 18

    # Yaha aapke project folder ka naam aayega (jaise SA-Calculator-v98.5)
    - name: Install Dependencies
      run: npm install
      working-directory: ./SA-Calculator-v98.5

    - name: Setup Java JDK
      uses: actions/setup-java@v3
      with:
        distribution: 'temurin'
        java-version: '17'

    - name: Build Web Assets and Sync Capacitor
      run: |
        npm run build --if-present
        npx cap sync android
      working-directory: ./SA-Calculator-v98.5

    - name: Build Debug APK with Gradle
      run: |
        cd android
        chmod +x gradlew
        ./gradlew assembleDebug
      working-directory: ./SA-Calculator-v98.5

    - name: Upload APK Artifact
      uses: actions/upload-artifact@v4
      with:
        name: app-debug-apk
        path: SA-Calculator-v98.5/android/app/build/outputs/apk/debug/app-debug.apk
